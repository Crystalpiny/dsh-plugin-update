# Normalize text files to LF in the repository; check out Windows
# scripts with CRLF so they work in cmd.exe / Windows PowerShell.
* text=auto eol=lf

*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
